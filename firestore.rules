rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================
    //   HELPER FUNCTIONS
    // ============================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isExec() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/executiveCommittee/$(request.auth.uid));
    }

    function isCommittee() {
      return isExec();
    }

    function isPrivileged() {
      return isAdmin() || isCommittee();
    }

    function isApprovedUser() {
      return isAuthenticated() &&
             (exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
              exists(/databases/$(database)/documents/executiveCommittee/$(request.auth.uid)));
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ============================
    //   CORE COLLECTIONS
    // ============================

    // 1. ADMINS
    match /admins/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }

    // 2. EVENTS
    match /events/{eventId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() ||
        (isExec() && (
          (resource.data.status == "upcoming" &&
           request.resource.data.status == "happening now") ||
          (resource.data.status == "happening now" &&
           request.resource.data.status == "completed") ||
          (resource.data.status == "happening now" &&
           request.resource.data.participants.size() >
           resource.data.participants.size())
        ));
    }

    // 3. PENDING REQUESTS
    match /pendingRequests/{uid} {
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow read: if isAdmin() || isOwner(uid);
      allow update, delete: if isOwner(uid) || isAdmin();
    }

    // 4. REJECTED REQUESTS
    match /rejectedRequests/{uid} {
      allow create: if isAdmin();
      allow read: if isAdmin() || isOwner(uid);
      allow update, delete: if isAdmin();
    }

    // 5. USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isApprovedUser() || isAdmin();
      allow create: if isOwner(userId) || isAdmin();
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // 6. EXECUTIVE COMMITTEE
    match /executiveCommittee/{userId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isOwner(userId) || isAdmin();
    }

    // 7. LEADERBOARD
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // 8. MONTHLY STARS
    match /monthlyStars/{docId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // 9. GALLERY
    match /gallery/{imageId} {
      allow read: if true;
      allow create: if isApprovedUser() || isAdmin();
      allow update, delete: if isAdmin();
    }

    // ============================
    //   RELIEF / DONATION SYSTEM
    // ============================

    // 10. MATERIAL REQUESTS
    match /materialRequests/{requestId} {
      allow read, create, update: if true;
      allow delete: if isAuthenticated() || isPrivileged();
    }

    // 11. DONATION OFFERS
    match /donationOffers/{offerId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated() || isPrivileged();
    }

    // 12. RELIEF ITEMS
    match /reliefItems/{itemId} {
      allow read: if true;
      allow create, update, delete: if isPrivileged();
    }

    // 13. RELIEF CONFIG
    match /reliefConfig/{configId} {
      allow read: if true;
      allow create, update, delete: if isPrivileged();
    }

    // ============================
    //   ADMIN SETTINGS
    // ============================

    match /adminSettings/public {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /adminSettings/secure {
      allow read, write: if isAdmin();
    }

    match /adminSettings/{settingId} {
      allow read: if isPrivileged();
      allow create, update, delete: if isAdmin();
    }

    // ============================
    //   MAGAZINES (FIXED POSITION)
    // ============================

    match /magazines/{magazineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ============================
    //   OC CALLS & APPLICATIONS
    // ============================

    match /ocCalls/{callId} {
      allow read: if true;
      allow create, update, delete: if isPrivileged() || isAdmin();
    }

    match /ocApplications/{appId} {
      allow read: if isPrivileged() || isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.applicantEmail == request.auth.token.email));
      allow create: if true;
      allow update, delete: if isPrivileged() || isAdmin();
    }

    // ============================
    //   DEFAULT DENY
    // ============================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

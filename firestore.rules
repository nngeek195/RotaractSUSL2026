rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is an Admin
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if user is a Committee Member
    function isCommittee() {
      return isAuthenticated() && exists(/databases/$(database)/documents/executiveCommittee/$(request.auth.uid));
    }

    // Check if user is Admin or Committee
    function isPrivileged() {
      return isAdmin() || isCommittee();
    }

    // --- Collections ---

    // 1. Admins (Strict Access)
    match /admins/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. Executive Committee
    match /executiveCommittee/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Users
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // 4. Pending Requests
    match /pendingRequests/{userId} {
      allow create: if true;
      allow read, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow update: if isAdmin();
    }

    // 5. Rejected Requests
    match /rejectedRequests/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // 6. Events / Projects
    match /events/{eventId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // 7. Relief Items
    match /reliefItems/{itemId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // 8. Relief Config
    match /reliefConfig/{configId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // 9. Material Requests
    match /materialRequests/{requestId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isPrivileged();
    }

    // 10. Donation Offers
    match /donationOffers/{offerId} {
      allow create: if true;
      allow read: if isPrivileged();
      allow write: if isPrivileged();
    }

    // 11. Admin Settings
    match /adminSettings/public {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Allow public read for 'general' temporarily for migration/fallback
    match /adminSettings/general {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /adminSettings/secure {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    // Fallback for other settings
    match /adminSettings/{settingId} {
      allow read: if isPrivileged();
      allow write: if isAdmin();
    }

    // 12. Leaderboard
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if isPrivileged();
    }
    
    // 13. Monthly Stars
    match /monthlyStars/{starId} {
      allow read: if true;
      allow write: if isPrivileged();
    }
  }
}

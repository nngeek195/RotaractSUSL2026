rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is an Admin
    function isAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Check if user is a Committee Member
    function isCommittee() {
      return isAuthenticated() && exists(/databases/$(database)/documents/executiveCommittee/$(request.auth.uid));
    }

    // Check if user is Admin or Committee
    function isPrivileged() {
      return isAdmin() || isCommittee();
    }

    // --- Collections ---

    // 1. Admins (Strict Access)
    match /admins/{userId} {
      // Only signed-in users can read (to check their own role)
      // Only admins can write (add/remove admins)
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // 2. Executive Committee (Public Read for "Our Team", Privileged Write)
    match /executiveCommittee/{userId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Users (General Members)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
    }

    // 4. Pending Requests (Join Flow)
    match /pendingRequests/{userId} {
      // Anyone can create a request (public signup)
      allow create: if true;
      // Users can read/delete their own request; Admins can manage all
      allow read, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      // Admins can update status
      allow update: if isAdmin();
    }

    // 5. Rejected Requests
    match /rejectedRequests/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow write: if isAdmin();
    }

    // 6. Events / Projects
    match /events/{eventId} {
      allow read: if true; // Publicly visible
      allow write: if isPrivileged(); // Admins/Committee manage events
    }

    // 7. Relief Items (Predefined list)
    match /reliefItems/{itemId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // 8. Relief Config (Bank details)
    match /reliefConfig/{configId} {
      allow read: if true;
      allow write: if isPrivileged();
    }

    // 9. Material Requests (Flood Relief)
    match /materialRequests/{requestId} {
      allow create: if true; // Public submission
      allow read: if true; // Public list (for stats/transparency)
      // Updates restricted to Privileged users
      // (Public tracking updates via token should be handled via API if strict security is needed,
      // currently relying on Admin dashboard for status updates)
      allow update, delete: if isPrivileged();
    }

    // 10. Donation Offers
    match /donationOffers/{offerId} {
      allow create: if true; // Public submission
      allow read: if isPrivileged(); // Private donor info
      allow write: if isPrivileged();
    }

    // 11. Admin Settings
    match /adminSettings/{settingId} {
      allow read: if isPrivileged();
      allow write: if isAdmin();
    }

    // 12. Leaderboard (If exists as collection)
    match /leaderboard/{docId} {
      allow read: if true;
      allow write: if isPrivileged();
    }
    
    // 13. Monthly Stars
    match /monthlyStars/{starId} {
      allow read: if true;
      allow write: if isPrivileged();
    }
  }
}
